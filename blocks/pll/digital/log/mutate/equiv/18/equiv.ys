read_rtlil /work/blocks/pll/digital/log/mutate/database/design.il
hierarchy -auto-top
flatten
rename -top ref
hierarchy -top ref
memory_map
write_json ref.json
write_rtlil ref.il
async2sync
design -stash ref
read_rtlil /work/blocks/pll/digital/log/mutate/database/design.il
hierarchy -auto-top
mutate -mode const1 -module pll_ctrl_regs -cell $auto$proc_dff.cc:220:proc_dff$130 -port Y -portbit 0
flatten
rename -top uut
hierarchy -top uut
memory_map
write_json uut.json
write_rtlil uut.il
async2sync
design -copy-from ref -as ref ref
miter -equiv -flatten -make_assert ref uut miter
hierarchy -top miter
select -assert-min 1 miter/t:$assert
sat -seq 8 -prove-asserts -set-init-zero -timeout 60 -verify miter
log CHECK_MUTATE_BASE_CASE_HELD
sat -tempinduct -maxsteps 8 -prove-asserts -set-init-zero -timeout 60 -verify miter
