read_rtlil /work/blocks/pll/digital/log/mutate/database/design.il
hierarchy -top pll_ctrl_regs
flatten
rename -top ref
hierarchy -top ref
memory_map
write_json ref.json
write_rtlil ref.il
async2sync
design -stash ref
read_rtlil /work/blocks/pll/digital/log/mutate/database/design.il
hierarchy -top pll_ctrl_regs
mutate -mode const1 -module pll_ctrl_regs -cell $auto$proc_dff.cc:220:proc_dff$130 -port Y -portbit 0
flatten
rename -top uut
hierarchy -top uut
memory_map
write_json uut.json
write_rtlil uut.il
async2sync
design -copy-from ref -as ref ref
equiv_make -make_assert ref uut eqa
equiv_make ref uut equiv
select -assert-min 1 eqa/t:$assert
select -assert-min 1 equiv/t:$equiv
sat -seq 8 -prove-asserts -set-init-zero -timeout 60 -verify eqa
equiv_induct -seq 8 equiv
equiv_status -assert equiv
