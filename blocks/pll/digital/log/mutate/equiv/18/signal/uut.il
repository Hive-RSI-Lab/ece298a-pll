  connect \pll_en \u_ctrl.pll_en
  connect \u_ctrl.cp_trim_in \cp_trim_in
  connect \u_ctrl.pll_en_in \pll_en_in
  connect \u_ctrl.rst_n \rst_n
  connect \u_ctrl.clk \clk
end
