* pll_analog_startup_tb.cir - enable-to-running bench (spec.yaml:
* startup_time_us). Written from spec/ only, before any netlist exists.
* Built on the step_settle_tb.cir window/verdict rules.
*
* 5 pF on vctrl and 5 pF on bias_ref (spec.md). The cell starts from its
* pll_en = 0 DC operating point (no uic); pll_en rises at t_en = 200 ns
* (1 ns edge). vctrl is held at 0.3 V, the low end of the tuning range and
* the slowest ring (worst case: spec.md names no vctrl for this measure),
* through 1 MOhm, so over the window it is effectively a floating, 5 pF-
* loaded node that the enable transient can kick.
*
* WINDOW: 5x the spec bound (5 us) = 25 us; topology.md gives no bias-loop
* time constant to size a longer one from.
* RUNNING, FULL SWING: rising 0.9*vdd crossings of vco_out after t_en. The
* final period T_f is the mean of the last 5 periods of the window. The
* startup time is the first such rising edge from which the next three
* periods are all within +-5 % of T_f and vco_out also falls below 0.1*vdd
* inside them. VERDICT: if there is no such edge, or it lies in the last
* 20 % of the window, or fewer than 12 full-swing rises occur, the bench
* prints `startup_time_us = not_settled` (sim_not_settled finding), never a
* number clamped to the window.
* START-UP KICK: a noiseless transient can leave the ring on its symmetric
* balance point (every ring node equal), unstable in a live ring but never
* left by ngspice without a perturbation (it11: stall at vctrl = 0.3 V).
* ikick injects 1 uA for 1 ns (1 fC) into ring node r1 at t_en + 1 ns, the
* stand-in for the device noise that starts a real ring; it is zero at the
* op, and a ring whose DC point is stable still decays back and stalls.
* sim_timeout_s: 1800

.include '/opt/eda-toolchain/iic-osic-tools-2026.09/foss/pdks/gf180mcuD/libs.tech/ngspice/design.spice'
.lib '/opt/eda-toolchain/iic-osic-tools-2026.09/foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.spice' ff
.lib '/opt/eda-toolchain/iic-osic-tools-2026.09/foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.spice' res_ff
.lib '/opt/eda-toolchain/iic-osic-tools-2026.09/foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.spice' mimcap_ff
* the loop filter's MOS caps: the PDK's cap_nmos_03v3_b (sm141064.spice, .lib
* moscap), written in charge form. The PDK's C(v) = A*(cvar1 + cvar2*tanh(cvar3*v
* + cvar4)) as a voltage-dependent C makes the transient step collapse ("timestep
* too small" on its current probe) at most corners on the extracted netlist;
* Q(v), its integral, is the same device and holds (pex tt_27c: Icp 18.52 vs
* 18.52 uA, Kvco 72.67 vs 72.66 MHz/V, fmax 203.31 vs 203.29 MHz against the
* PDK form under Gear). Its corner factor follows the MIM corner's
* (mim_corner_2p0ff: 1 / 1.1 ss / 0.9 ff, as moscap_<corner> sets it).
.param cap_nmos_03v3_b_corner=mim_corner_2p0ff
.subckt cap_nmos_03v3_b 1 2 c_length=1e-6 c_width=1e-6 dtemp=0
.param cvar1=0.002458 cvar2=0.001533 cvar3=1.515152 cvar4=0.560606
C1 1 2 q='cap_nmos_03v3_b_corner*c_length*c_width*(cvar1*v(1,2)+cvar2/cvar3*ln(cosh(cvar3*v(1,2)+cvar4)))'
.ends cap_nmos_03v3_b
.include '/home/hive2/projects/ece298a-pll/blocks/pll/analog/netlist/pll_analog.cir'
.param w_bp='4e-06' l_bp='2e-06' w_b1='2e-06' l_b1='2e-06' w_b2='4e-06' l_b2='1e-06' rb_l=0.000366 rbt_l=0.00018 w_cpn='2e-05' l_cpn='2e-06' w_cpp='5e-05' l_cpp='2e-06' w_swn='2e-06' w_swp='4e-06' l_sw='5e-07' r1_l=0.00015 c1_w=0.00042 c1_l=1.2e-05 c2_w=4.3e-05 c2_l=1.2e-05 w_v2i='1e-05' l_v2i='1e-06' rv2i_l=3.5e-05 w_flr='2e-06' l_flr='2e-06' w_v2ip='1e-05' w_v2in='4e-06' l_v2i2='5e-07' w_sp='1e-05' w_sn='4e-06' l_s='5e-07' w_rp='6e-06' w_rn='3e-06' l_r=2.8e-07 w_gp='4e-06' w_gn='4e-06' w_op=1.2e-05 w_on='6e-06' m_buft=4 w_bufp='2e-05' l_bufp='1e-06' w_bufn='1e-05' l_bufn='1e-06' w_bufln='4e-06' w_buflp='8e-06' l_bufl='2e-06' w_cl='4e-05' l_cl='2e-06'

.temp 125
.param vddp=3.3
.param t_bound=5u
.param t_en=200n t_win={5*t_bound}
.csparam ten={t_en}
.csparam t_stop={t_en+t_win}
.csparam t_tail={t_en+0.8*t_win}
.csparam v90={0.9*vddp}
.csparam v10={0.1*vddp}

vdd_src  vdd      0 {vddp}
vss_src  vss      0 0
ven      pll_en   0 pwl(0 0 {t_en} 0 {t_en+1n} {vddp})
vup      pfd_up   0 0
vdn      pfd_dn   0 0
vt0      cp_trim0 0 0
vt1      cp_trim1 0 0
vvc      vfeed    0 0.3
rfeed    vfeed    vctrl 1meg
cpadv    vctrl    0 5p
cpadb    bias_ref 0 5p
cload2   vco_div2 0 30f
xdut vco_div2 pfd_up pfd_dn pll_en cp_trim0 cp_trim1 vctrl bias_ref vdd vss pll_analog
ikick    0        xdut.r1 pulse(0 1u {t_en+1n} 50p 50p 1n 1)

.control
set noaskquit
tran 100p $&t_stop 0 100p
let nx = length(time)
let nx1 = nx - 1
let nx2 = nx - 2
let hi = (v(xdut.vco_out) gt v90)
let rs = ((hi[1,$&nx1] - hi[0,$&nx2]) gt 0.5) and (time[1,$&nx1] gt ten)
let nr = mean(rs)*length(rs)
set res = "not_settled"
if nr ge 12
  let ka = nr - 6
  let kb = nr - 1
  meas tran tfa when v(xdut.vco_out)=$&v90 rise=$&ka td=$&ten
  meas tran tfb when v(xdut.vco_out)=$&v90 rise=$&kb td=$&ten
  let tfin = (tfb - tfa)/5
  meas tran t0 when v(xdut.vco_out)=$&v90 rise=1 td=$&ten
  meas tran t1 when v(xdut.vco_out)=$&v90 rise=2 td=$&ten
  meas tran t2 when v(xdut.vco_out)=$&v90 rise=3 td=$&ten
  meas tran t3 when v(xdut.vco_out)=$&v90 rise=4 td=$&ten
  let k = 4
  let found = 0
  while (found eq 0) and (t0 lt t_tail)
    let e1 = abs(t1 - t0 - tfin)
    let e2 = abs(t2 - t1 - tfin)
    let e3 = abs(t3 - t2 - tfin)
    let lim = 0.05*tfin
    if (e1 lt lim) and (e2 lt lim) and (e3 lt lim)
      meas tran vlo min v(xdut.vco_out) from=$&t0 to=$&t3
      if vlo lt v10
        let found = 1
      end
    end
    if found eq 0
      if k ge kb
        let t0 = t_tail
      else
        let k = k + 1
        let t0 = t1
        let t1 = t2
        let t2 = t3
        meas tran t3 when v(xdut.vco_out)=$&v90 rise=$&k td=$&ten
      end
    end
  end
  if (found eq 1) and (t0 lt t_tail)
    let x = (t0 - ten)*1e6
    set res = "$&x"
  end
end
echo
echo "  Measurements for Transient Analysis (pll_analog_startup_tb, computed in .control)"
echo "startup_time_us = $res"
echo
.endc

.end
