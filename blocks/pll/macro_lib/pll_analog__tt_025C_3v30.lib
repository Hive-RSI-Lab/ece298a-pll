    vomin : 0 ;
    vomax : 3.3 ;
  }
  lu_table_template (macro_slew_load) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("1, 2");
    index_2 ("1, 2, 3");
  }
  lu_table_template (macro_load) {
    variable_1 : total_output_net_capacitance;
    index_1 ("1, 2, 3");
  }
  cell (pll_analog) {
    is_macro_cell : true;
    pin ("cp_trim0") {
      direction : input;
      capacitance : 0.012682;
      rise_capacitance : 0.012099;
      fall_capacitance : 0.012682;
      max_transition : 3;
    }
    pin ("cp_trim1") {
